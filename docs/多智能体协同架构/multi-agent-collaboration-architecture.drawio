  <diagram id="multi-agent-collaboration" name="多智能体协同架构图">
    <mxGraphModel dx="1500" dy="980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="多智能体协同架构图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Microsoft YaHei;fontSize=32;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="520" y="30" width="460" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="各 Agent 不直接相互调用，通过共享状态 TripState 读写字段完成协作、重试、预算校验与重规划" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="360" y="78" width="780" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="userInput" value="&lt;b&gt;用户输入&lt;/b&gt;&lt;br&gt;目的地、日期、人数&lt;br&gt;预算、偏好、出发地&lt;br&gt;交通方式约束" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#1e293b;align=left;spacingLeft=18;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="610" y="135" width="280" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="tripState" value="&lt;b&gt;TripState 共享状态&lt;/b&gt;&lt;br&gt;&lt;br&gt;保存：用户输入、各 Agent 输出、错误信息&lt;br&gt;保存：预算结果、迭代次数、最终计划&lt;br&gt;机制：各 Agent 读取所需字段&lt;br&gt;机制：执行结果写回指定状态字段&lt;br&gt;目标：降低 Agent 间直接耦合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f97316;strokeWidth=3;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#431407;align=left;spacingLeft=22;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="345" width="380" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="parallelArea" value="并发数据收集阶段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=1;fontColor=#1e293b;align=left;spacingLeft=18;verticalAlign=top;spacingTop=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="295" width="390" height="390" as="geometry"/>
        </mxCell>
        <mxCell id="parallelNote" value="POI、Weather、Hotel、Transport 可并行执行&lt;br&gt;Transport 仅在填写出发地时执行" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="95" y="335" width="320" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="poi" value="&lt;b&gt;POI Agent&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;输入：目的地、日期、偏好&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;输出：景点列表、开放信息、推荐游玩时长&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0891b2;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#0f172a;align=left;spacingLeft=14;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="395" width="330" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="weather" value="&lt;b&gt;Weather Agent&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;输入：目的地、日期&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;输出：天气预报、温度、出行提醒&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0891b2;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#0f172a;align=left;spacingLeft=14;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="485" width="330" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="hotel" value="&lt;b&gt;Hotel Agent&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;输入：目的地、日期、人数、预算&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;输出：酒店候选、价格、位置&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0891b2;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#0f172a;align=left;spacingLeft=14;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="575" width="330" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="transport" value="&lt;b&gt;Transport Agent&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;输入：出发地、目的地、日期、交通方式&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;输出：路线、耗时、票价或交通成本&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0891b2;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#0f172a;align=left;spacingLeft=14;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="665" width="330" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="planningArea" value="计划生成与预算校验阶段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=18;fontStyle=1;fontColor=#1e293b;align=left;spacingLeft=18;verticalAlign=top;spacingTop=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1040" y="315" width="390" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="planner" value="&lt;b&gt;Planner Agent&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;输入：多 Agent 输出、偏好、日期、人数、预算、交通信息&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;输出：初步计划 / 重规划结果&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#0f172a;align=left;spacingLeft=14;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1070" y="395" width="330" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="budget" value="&lt;b&gt;Budget Agent&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;输入：行程计划、预算、人数&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;输出：预算验证结果、超预算金额、节省建议&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#0f172a;align=left;spacingLeft=14;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1070" y="545" width="330" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="router" value="&lt;b&gt;Workflow Router / 异常处理&lt;/b&gt;&lt;br&gt;读取 failed_agent、error_reason、retry_count&lt;br&gt;按失败标记单独重试对应数据收集 Agent&lt;br&gt;重试无效时触发 Planner 降级补全" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#7f1d1d;align=left;spacingLeft=18;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="735" width="380" height="115" as="geometry"/>
        </mxCell>

        <mxCell id="finalOutput" value="&lt;b&gt;最终输出&lt;/b&gt;&lt;br&gt;可用旅游计划&lt;br&gt;预算明细与节省建议&lt;br&gt;地图、酒店、交通参考" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#14532d;align=left;spacingLeft=18;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1070" y="765" width="330" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="legend" value="图例：灰色虚线 = 读取 TripState 字段；蓝色实线 = 写回 TripState 字段；绿色实线 = 通过校验进入最终输出；红色虚线 = 异常、重试、重规划或降级路径。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#334155;align=left;spacingLeft=18;verticalAlign=middle;arcSize=8;" vertex="1" parent="1">
