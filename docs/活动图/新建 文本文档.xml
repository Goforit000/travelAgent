<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="1500" height="1980" viewBox="0 0 1500 1980">
  <defs>
    <linearGradient id="pageBg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#f8fafc"/>
      <stop offset="100%" stop-color="#eef2ff"/>
    </linearGradient>

    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="4" stdDeviation="5" flood-color="#0f172a" flood-opacity="0.14"/>
    </filter>

    <marker id="arrow" markerWidth="12" markerHeight="12" refX="11" refY="4" orient="auto" markerUnits="strokeWidth">
      <path d="M0,0 L0,8 L12,4 z" fill="#475569"/>
    </marker>

    <style>
      .title {
        font: 700 30px "Microsoft YaHei", "SimHei", Arial, sans-serif;
        fill: #0f172a;
      }

      .subtitle {
        font: 14px "Microsoft YaHei", "SimHei", Arial, sans-serif;
        fill: #64748b;
      }

      .lane-header {
        fill: #1e293b;
      }

      .lane-title {
        font: 700 17px "Microsoft YaHei", "SimHei", Arial, sans-serif;
        fill: #ffffff;
      }

      .lane-1 { fill: #eff6ff; stroke: #bfdbfe; }
      .lane-2 { fill: #f0fdf4; stroke: #bbf7d0; }
      .lane-3 { fill: #fff7ed; stroke: #fed7aa; }
      .lane-4 { fill: #f5f3ff; stroke: #ddd6fe; }
      .lane-5 { fill: #fdf2f8; stroke: #fbcfe8; }

      .node {
        fill: #ffffff;
        stroke: #2563eb;
        stroke-width: 1.8;
        rx: 12;
        filter: url(#shadow);
      }

      .node-green {
        fill: #ffffff;
        stroke: #16a34a;
        stroke-width: 1.8;
        rx: 12;
        filter: url(#shadow);
      }

      .node-orange {
        fill: #ffffff;
        stroke: #ea580c;
        stroke-width: 1.8;
        rx: 12;
        filter: url(#shadow);
      }

      .node-purple {
        fill: #ffffff;
        stroke: #7c3aed;
        stroke-width: 1.8;
        rx: 12;
        filter: url(#shadow);
      }

      .node-pink {
        fill: #ffffff;
        stroke: #db2777;
        stroke-width: 1.8;
        rx: 12;
        filter: url(#shadow);
      }

      .decision {
        fill: #fff7ed;
        stroke: #f97316;
        stroke-width: 2;
        filter: url(#shadow);
      }

      .text {
        font: 15px "Microsoft YaHei", "SimHei", Arial, sans-serif;
        fill: #0f172a;
      }

      .small {
        font: 12px "Microsoft YaHei", "SimHei", Arial, sans-serif;
        fill: #475569;
      }

      .condition {
        font: 12px "Microsoft YaHei", "SimHei", Arial, sans-serif;
        fill: #b45309;
        font-weight: 700;
      }

      .arrow {
        stroke: #475569;
        stroke-width: 1.8;
        fill: none;
        marker-end: url(#arrow);
      }

      .arrow-soft {
        stroke: #64748b;
        stroke-width: 1.5;
        fill: none;
        stroke-dasharray: 6 5;
        marker-end: url(#arrow);
      }

      .bar {
        fill: #0f172a;
        rx: 4;
      }

      .bar-label {
        font: 13px "Microsoft YaHei", "SimHei", Arial, sans-serif;
        fill: #334155;
        font-weight: 700;
      }

      .start {
        fill: #0f172a;
      }

      .end-outer {
        fill: #ffffff;
        stroke: #0f172a;
        stroke-width: 2.4;
      }

      .end-inner {
        fill: #0f172a;
      }

      .note {
        font: 13px "Microsoft YaHei", "SimHei", Arial, sans-serif;
        fill: #334155;
      }
    </style>
  </defs>

  <rect x="0" y="0" width="1500" height="1980" fill="url(#pageBg)"/>
  <rect x="36" y="32" width="1428" height="1908" fill="#ffffff" stroke="#cbd5e1" rx="26" filter="url(#shadow)"/>

  <text x="750" y="82" text-anchor="middle" class="title">旅游计划生成活动图</text>
  <text x="750" y="110" text-anchor="middle" class="subtitle">基于多智能体协同的个性化旅游规划系统</text>

  <!-- Swimlane geometry -->
  <g id="lanes">
    <rect x="70" y="145" width="260" height="1700" class="lane-1" rx="16"/>
    <rect x="330" y="145" width="260" height="1700" class="lane-2" rx="16"/>
    <rect x="590" y="145" width="260" height="1700" class="lane-3" rx="16"/>
    <rect x="850" y="145" width="260" height="1700" class="lane-4" rx="16"/>
    <rect x="1110" y="145" width="320" height="1700" class="lane-5" rx="16"/>

    <rect x="70" y="145" width="260" height="48" class="lane-header" rx="16"/>
    <rect x="330" y="145" width="260" height="48" class="lane-header" rx="16"/>
    <rect x="590" y="145" width="260" height="48" class="lane-header" rx="16"/>
    <rect x="850" y="145" width="260" height="48" class="lane-header" rx="16"/>
    <rect x="1110" y="145" width="320" height="48" class="lane-header" rx="16"/>

    <text x="200" y="176" text-anchor="middle" class="lane-title">用户</text>
    <text x="460" y="176" text-anchor="middle" class="lane-title">前端系统</text>
    <text x="720" y="176" text-anchor="middle" class="lane-title">后端工作流</text>
    <text x="980" y="176" text-anchor="middle" class="lane-title">数据收集智能体</text>
    <text x="1270" y="176" text-anchor="middle" class="lane-title">规划与校验智能体</text>
  </g>

  <!-- User lane -->
  <circle cx="200" cy="230" r="13" class="start"/>

  <rect x="110" y="280" width="180" height="70" class="node"/>
  <text x="200" y="307" text-anchor="middle" class="text">填写旅行信息</text>
  <text x="200" y="329" text-anchor="middle" class="small">目的地、出发地、日期</text>
  <text x="200" y="346" text-anchor="middle" class="small">人数、预算与偏好</text>

  <rect x="110" y="405" width="180" height="56" class="node"/>
  <text x="200" y="438" text-anchor="middle" class="text">提交生成请求</text>

  <rect x="110" y="1688" width="180" height="56" class="node"/>
  <text x="200" y="1722" text-anchor="middle" class="text">查看旅游计划</text>

  <circle cx="200" cy="1792" r="18" class="end-outer"/>
  <circle cx="200" cy="1792" r="10" class="end-inner"/>

  <!-- Frontend lane -->
  <rect x="370" y="505" width="180" height="56" class="node-green"/>
  <text x="460" y="539" text-anchor="middle" class="text">校验表单输入</text>

  <polygon points="460,615 545,670 460,725 375,670" class="decision"/>
  <text x="460" y="666" text-anchor="middle" class="text">表单是否合法</text>
  <text x="460" y="687" text-anchor="middle" class="small">?</text>

  <rect x="370" y="785" width="180" height="56" class="node-green"/>
  <text x="460" y="819" text-anchor="middle" class="text">发送生成请求</text>

  <rect x="370" y="1010" width="180" height="76" class="node-green"/>
  <text x="460" y="1039" text-anchor="middle" class="text">接收 SSE 事件</text>
  <text x="460" y="1061" text-anchor="middle" class="small">实时显示 Agent 状态</text>
  <text x="460" y="1078" text-anchor="middle" class="small">和整体进度</text>

  <rect x="370" y="1604" width="180" height="70" class="node-green"/>
  <text x="460" y="1632" text-anchor="middle" class="text">接收最终结果</text>
  <text x="460" y="1654" text-anchor="middle" class="small">展示行程、地图</text>
  <text x="460" y="1671" text-anchor="middle" class="small">预算与交通信息</text>

  <!-- Backend lane -->
  <rect x="630" y="880" width="180" height="76" class="node-orange"/>
  <text x="720" y="909" text-anchor="middle" class="text">接收请求</text>
  <text x="720" y="931" text-anchor="middle" class="small">构造 TripState</text>
  <text x="720" y="948" text-anchor="middle" class="small">启动 LangGraph</text>

  <rect x="630" y="1260" width="180" height="60" class="node-orange"/>
  <text x="720" y="1296" text-anchor="middle" class="text">汇总多源数据</text>

  <polygon points="720,1370 815,1425 720,1480 625,1425" class="decision"/>
  <text x="720" y="1418" text-anchor="middle" class="text">是否存在异常</text>
  <text x="720" y="1440" text-anchor="middle" class="small">或空数据?</text>

  <rect x="630" y="1518" width="180" height="70" class="node-orange"/>
  <text x="720" y="1546" text-anchor="middle" class="text">重试失败 Agent</text>
  <text x="720" y="1568" text-anchor="middle" class="small">或降级补全</text>

  <rect x="630" y="1680" width="180" height="70" class="node-orange"/>
  <text x="720" y="1708" text-anchor="middle" class="text">finalize 解析</text>
  <text x="720" y="1730" text-anchor="middle" class="small">保存历史记录</text>
  <text x="720" y="1747" text-anchor="middle" class="small">返回 TripPlan</text>

  <!-- Data collection lane -->
  <rect x="882" y="1030" width="196" height="54" class="node-purple"/>
  <text x="980" y="1063" text-anchor="middle" class="text">POI Agent 搜索景点</text>

  <rect x="882" y="1105" width="196" height="54" class="node-purple"/>
  <text x="980" y="1138" text-anchor="middle" class="text">Weather Agent 查天气</text>

  <rect x="882" y="1180" width="196" height="54" class="node-purple"/>
  <text x="980" y="1213" text-anchor="middle" class="text">Hotel Agent 搜酒店</text>

  <polygon points="980,1268 1078,1328 980,1388 882,1328" class="decision"/>
  <text x="980" y="1322" text-anchor="middle" class="text">是否填写出发地</text>
  <text x="980" y="1344" text-anchor="middle" class="small">?</text>

  <rect x="882" y="1430" width="196" height="70" class="node-purple"/>
  <text x="980" y="1458" text-anchor="middle" class="text">Transport Agent</text>
  <text x="980" y="1480" text-anchor="middle" class="small">查询自驾、高铁</text>
  <text x="980" y="1497" text-anchor="middle" class="small">或航班信息</text>

  <rect x="882" y="1536" width="196" height="54" class="node-purple"/>
  <text x="980" y="1569" text-anchor="middle" class="text">跳过交通规划</text>

  <!-- Planner and budget lane -->
  <rect x="1165" y="1388" width="210" height="72" class="node-pink"/>
  <text x="1270" y="1418" text-anchor="middle" class="text">Planner Agent</text>
  <text x="1270" y="1440" text-anchor="middle" class="small">综合多源数据</text>
  <text x="1270" y="1457" text-anchor="middle" class="small">生成结构化行程</text>

  <rect x="1165" y="1508" width="210" height="72" class="node-pink"/>
  <text x="1270" y="1538" text-anchor="middle" class="text">Budget Agent</text>
  <text x="1270" y="1560" text-anchor="middle" class="small">计算预算并校验</text>
  <text x="1270" y="1577" text-anchor="middle" class="small">是否超出人均预算</text>

  <polygon points="1270,1622 1380,1685 1270,1748 1160,1685" class="decision"/>
  <text x="1270" y="1680" text-anchor="middle" class="text">预算是否超限</text>
  <text x="1270" y="1702" text-anchor="middle" class="small">?</text>

  <rect x="1165" y="1810" width="210" height="70" class="node-pink"/>
  <text x="1270" y="1838" text-anchor="middle" class="text">生成修改建议</text>
  <text x="1270" y="1860" text-anchor="middle" class="small">返回 Planner 重规划</text>

  <!-- Fork / Join bars -->
  <rect x="635" y="1000" width="710" height="10" class="bar"/>
  <text x="650" y="990" class="bar-label">Fork：并行数据收集</text>

  <rect x="635" y="1242" width="710" height="10" class="bar"/>
  <text x="650" y="1232" class="bar-label">Join：基础数据收集完成</text>

  <!-- Main arrows -->
  <path d="M200 243 L200 280" class="arrow"/>
  <path d="M200 350 L200 405" class="arrow"/>
  <path d="M290 433 C335 433, 335 533, 370 533" class="arrow"/>
  <path d="M460 561 L460 615" class="arrow"/>
  <path d="M460 725 L460 785" class="arrow"/>
  <text x="474" y="760" class="condition">[合法]</text>

  <path d="M375 670 C300 670, 300 315, 290 315" class="arrow"/>
  <text x="303" y="648" class="condition">[不合法]</text>

  <path d="M550 813 C590 813, 595 900, 630 918" class="arrow"/>
  <path d="M720 956 L720 1000" class="arrow"/>

  <!-- SSE progress -->
  <path d="M630 918 C560 945, 550 1038, 550 1048" class="arrow-soft"/>
  <text x="562" y="999" class="small">持续推送进度事件</text>

  <!-- Fork to data collection nodes -->
  <path d="M980 1010 L980 1030" class="arrow"/>
  <path d="M980 1084 L980 1105" class="arrow"/>
  <path d="M980 1159 L980 1180" class="arrow"/>
  <path d="M980 1234 L980 1268" class="arrow"/>

  <!-- Data nodes to join -->
  <path d="M882 1057 C820 1057, 760 1080, 760 1242" class="arrow"/>
  <path d="M882 1132 C835 1132, 805 1165, 805 1242" class="arrow"/>
  <path d="M882 1207 C860 1207, 850 1220, 850 1242" class="arrow"/>

  <!-- Transport condition -->
  <path d="M980 1388 L980 1430" class="arrow"/>
  <text x="1000" y="1415" class="condition">[已填写]</text>
  <path d="M882 1328 C835 1328, 835 1563, 882 1563" class="arrow"/>
  <text x="842" y="1368" class="condition">[未填写]</text>
  <path d="M980 1500 C1048 1500, 1115 1360, 1300 1242" class="arrow"/>
  <path d="M980 1590 C1080 1590, 1140 1370, 1330 1242" class="arrow"/>

  <!-- Join to backend data summary -->
  <path d="M720 1252 L720 1260" class="arrow"/>
  <path d="M720 1320 L720 1370" class="arrow"/>

  <!-- Error branch -->
  <path d="M815 1425 C850 1425, 850 1553, 810 1553" class="arrow"/>
  <text x="830" y="1460" class="condition">[是]</text>
  <path d="M720 1588 C730 1635, 1010 1320, 1165 1424" class="arrow"/>

  <path d="M815 1425 C950 1425, 1050 1425, 1165 1424" class="arrow"/>
  <text x="850" y="1402" class="condition">[否]</text>

  <!-- Planner budget flow -->
  <path d="M1270 1460 L1270 1508" class="arrow"/>
  <path d="M1270 1580 L1270 1622" class="arrow"/>

  <path d="M1160 1685 C1030 1685, 910 1715, 810 1715" class="arrow"/>
  <text x="1040" y="1665" class="condition">[未超限]</text>

  <path d="M1380 1685 C1418 1685, 1418 1715, 810 1715" class="arrow"/>
  <text x="1296" y="1658" class="condition">[超限且达到上限]</text>

  <path d="M1270 1748 L1270 1810" class="arrow"/>
  <text x="1288" y="1785" class="condition">[超限且次数 &lt; 上限]</text>
  <path d="M1165 1845 C1108 1845, 1105 1410, 1165 1424" class="arrow"/>

  <!-- Final -->
  <path d="M720 1750 C700 1770, 560 1640, 550 1640" class="arrow"/>
  <path d="M370 1640 C335 1640, 325 1716, 290 1716" class="arrow"/>
  <path d="M200 1744 L200 1774" class="arrow"/>

  <!-- Legend -->
  <rect x="95" y="1872" width="1310" height="46" fill="#f8fafc" stroke="#cbd5e1" rx="14"/>
  <text x="750" y="1901" text-anchor="middle" class="note">
    注：该活动图展示需求阶段的粗粒度业务活动，重点体现并行数据收集、条件线程、异常处理和 Planner-Budget 预算反馈循环。
  </text>
</svg>
